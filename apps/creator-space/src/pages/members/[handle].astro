---
import Base from '../../layouts/Base.astro';import ContentCard from '../../components/ContentCard.astro';import {publicDB} from '../../lib/server';
const handle=Astro.params.handle!;let profile:Record<string,any>|null=null,works:Record<string,any>[]=[],experience:Record<string,any>[]=[],contacts:Record<string,any>[]=[],error=false;
try{const db=publicDB();const r=await db.from('member_profiles').select('*').eq('handle',handle).eq('visibility','public').maybeSingle();if(r.error)throw r.error;profile=r.data;if(profile){const [w,m,c]=await Promise.all([db.from('creator_entries').select('*').eq('kind','work').eq('owner_id',profile.user_id).eq('visibility','public').is('deleted_at',null).order('created_at',{ascending:false}).limit(50),db.from('project_memberships').select('role,description,project_id').eq('user_id',profile.user_id).eq('status','accepted'),db.from('profile_contacts').select('contact_type,contact_value').eq('user_id',profile.user_id).eq('visibility','public')]);for(const e of [w.error,m.error,c.error])if(e)throw e;works=w.data||[];contacts=c.data||[];for(const member of m.data||[]){const p=await db.from('creator_projects').select('id,title,summary').eq('id',member.project_id).eq('visibility','public').maybeSingle();if(p.error)throw p.error;if(p.data)experience.push({...p.data,role:member.role,description:member.description});}}}catch{error=true;Astro.response.status=503;}
---
<Base title={profile?.display_name||'프로필'} description={profile?.bio||'크리에이터 프로필과 확인된 작업 이력'} noindex={!profile||error}><article class="cs-detail cs-section" data-member-profile data-handle={handle}><div class="profile-view-heading"><div><span class="eyebrow">CREATOR PROFILE</span><h1 data-member-name>{profile?.display_name||'프로필 확인'}</h1></div><a class="button secondary" href="/account/profile/" data-member-edit hidden>프로필 수정</a></div><p class="cs-body" data-member-bio>{profile?.bio}</p><p data-member-meta>{[profile?.school_name,profile?.department_name,profile?.primary_role].filter(Boolean).join(' · ')}</p><p role="status" data-member-status>{error?'프로필 연결에 실패했습니다.':!profile?'공개 프로필이 없습니다. 회원 전용 프로필은 로그인 후 확인해 주세요.':''}</p><div class="cs-list" data-member-contacts>{contacts.map(c=><p>{c.contact_type}: {c.contact_value}</p>)}</div><h2>작품</h2><div class="cs-grid" data-member-works>{works.map(item=><ContentCard item={item} kind="work"/>)}</div><h2>프로젝트 참여 이력</h2><p>참여자가 직접 수락한 프로젝트 이력입니다.</p><div class="cs-list" data-member-experience>{experience.map(p=><a class="cs-item" href={`/projects/${p.id}/`}><h3>{p.title}</h3><strong>{p.role} · 참여 확인됨</strong><p>{p.description}</p></a>)}</div></article><script>import '../../lib/member';</script></Base>
