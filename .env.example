# Origin only; do not include the repository path.
SITE_URL=https://example.com
# GitHub project Pages: /repository-name/ ; custom domain or user Pages: /
BASE_PATH=/

# Optional: enables shared likes, comments, Space posts, reports and admin.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# OAuth buttons are the public sign-in path. Enable providers in Supabase first.
# Keep the legacy operator magic-link form off for public builds.
PUBLIC_EMAIL_LOGIN=false

# Enable only after 0004 has been applied and its RLS/Storage QA has passed.
PUBLIC_SPACE_EXTENDED=false

# Optional: trusted Decap GitHub OAuth service origin, for remote content editing.
PUBLIC_CMS_AUTH_URL=
