---
import Base from '../../layouts/Base.astro';import {publicDB,kinds,safeURL,uuid,type Kind} from '../../lib/server';
const kind=(Object.keys(kinds)as Kind[]).find(k=>kinds[k].path===Astro.params.collection),id=Astro.params.id;
if(!kind||!uuid(id))return Astro.redirect('/404/');
let item:Record<string,any>|null=null,error=false;
try{let q=publicDB().from(kind==='project'?'creator_projects':'creator_entries').select('*').eq('id',id!).eq('visibility','public').is('deleted_at',null);if(kind!=='project')q=q.eq('kind',kind).eq('moderation_status','visible');const result=await q.maybeSingle();if(result.error)throw result.error;item=result.data;}catch{error=true;Astro.response.status=503;}
const cover=safeURL(item?.cover_url);
---
<Base title={item?.title||'콘텐츠 확인'} description={item?.summary||'로그인 후 열람 권한을 확인합니다.'} noindex={!item||error}><article class="cs-detail cs-section" data-detail data-id={id} data-kind={kind}><a href={`/${kinds[kind].path}/`}>← {kinds[kind].label}</a><p class="cs-note" data-detail-status role="status">{error?'서버 연결에 실패했습니다.':item?'':'공개되지 않았거나 존재하지 않는 콘텐츠입니다. 로그인 후 열람 권한을 확인할 수 있습니다.'}</p><h1 data-title>{item?.title||'콘텐츠 확인'}</h1><p data-summary>{item?.summary}</p><p class="cs-meta" data-meta>{item?.category}</p><img class="cs-cover" data-cover src={cover||undefined} alt={item?.cover_alt||''} hidden={!cover} referrerpolicy="no-referrer"/><div class="cs-body" data-body>{item?.body}</div><div class="cs-actions" data-links>{safeURL(item?.video_url)&&<a href={safeURL(item?.video_url)!} target="_blank" rel="noopener noreferrer">플레이 영상 보기 ↗</a>}{safeURL(item?.external_url||item?.result_url)&&<a href={safeURL(item?.external_url||item?.result_url)!} target="_blank" rel="noopener noreferrer">결과물 / 관련 링크 ↗</a>}</div><div class="cs-actions" data-author-actions hidden><a class="button primary" href={`/studio/?kind=${kind}&id=${id}`}>수정하기</a><button class="button secondary" data-delete>삭제</button></div>
<section data-project-section hidden><h2>확인된 참여자</h2><div class="cs-list" data-memberships></div><form data-invite hidden><h3>프로젝트 참여 초대</h3><label>회원 이메일<input name="email" type="email" required/></label><label>역할<input name="role" minlength="2" maxlength="80" required/></label><label>참여 내용<textarea name="description" maxlength="1000"></textarea></label><button class="button primary">참여 확인 요청</button></form></section>
<section class="cs-section" data-interactions hidden><div class="cs-actions"><button class="button secondary" data-like>♡ 좋아요</button><button class="text-link" data-report>신고</button></div><h2>댓글</h2><div class="cs-list" data-comments></div><form data-comment-form><label>댓글 작성<textarea name="body" required minlength="2" maxlength="2000"></textarea></label><button class="button primary">댓글 게시</button></form></section></article><script>import '../../lib/detail';</script></Base>
