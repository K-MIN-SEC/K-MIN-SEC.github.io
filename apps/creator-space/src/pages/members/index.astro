---
import Base from '../../layouts/Base.astro';import {publicDB} from '../../lib/server';
const q=(Astro.url.searchParams.get('q')||'').slice(0,80),year=Number(Astro.url.searchParams.get('year'))||null,role=(Astro.url.searchParams.get('role')||'').slice(0,80),page=Math.max(1,Math.min(10000,Number(Astro.url.searchParams.get('page'))||1));
let profiles:Record<string,any>[]=[],error=false;
try{let query=publicDB().from('member_profiles').select('handle,display_name,bio,primary_role,admission_year,graduation_year,tools,availability').eq('visibility','public');if(q)query=query.ilike('display_name',`%${q.replace(/[%_]/g,'')}%`);if(year)query=query.eq('admission_year',year);if(role)query=query.ilike('primary_role',`%${role.replace(/[%_]/g,'')}%`);const r=await query.order('updated_at',{ascending:false}).range((page-1)*24,page*24);if(r.error)throw r.error;profiles=r.data;}catch{error=true;Astro.response.status=503;}
const next=new URL(Astro.url);next.searchParams.set('page',String(page+1));
---
<Base title="사람들 · 포트폴리오 아카이브" noindex={error||Boolean(q||year||role)||page>1}><header class="page-header"><span class="eyebrow">PEOPLE & PORTFOLIOS</span><h1>함께 만들어갈 사람들.</h1><p>공개 프로필과 작업, 확인된 프로젝트 경험을 살펴보세요.</p><a class="button primary" href="/account/">내 프로필 편집</a></header><form class="cs-filters"><input name="q" value={q} placeholder="이름" aria-label="이름"/><input name="year" value={year} type="number" min="2000" max="2100" placeholder="입학년도" aria-label="입학년도"/><input name="role" value={role} placeholder="직군" aria-label="직군"/><button class="button secondary">검색</button></form>{error?<p class="cs-empty">프로필을 불러오지 못했습니다.</p>:profiles.length?<div class="cs-grid">{profiles.slice(0,24).map(p=><a href={`/members/${p.handle}/`} class="cs-card"><span class="eyebrow">{p.primary_role||'CREATOR'}</span><h2>{p.display_name}</h2><p>{p.bio}</p><small>{p.admission_year?`${p.admission_year}학번`:''} · {(p.tools||[]).join(' / ')}</small><span>{p.availability==='available'?'프로젝트 참여 가능 ↗':''}</span></a>)}</div>:<p class="cs-empty">조건에 맞는 공개 프로필이 없습니다.</p>}{profiles.length>24&&<a href={next.pathname+next.search}>다음 페이지 →</a>}</Base>
