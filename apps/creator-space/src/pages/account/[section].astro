---
import Base from '../../layouts/Base.astro';
import AccountNav from '../../components/AccountNav.astro';
import CreatorProfilePanel from '../../components/CreatorProfilePanel.astro';
const titles:Record<string,string>={profile:'프로필 수정',contacts:'연락처 관리',creator:'Creator 신청'};
const section=Astro.params.section||'';if(!titles[section])return Astro.redirect('/404/');
---
<Base title={titles[section]} noindex><header class="compact-header"><span class="eyebrow">MY ACCOUNT</span><h1>{titles[section]}</h1><p>{section==='profile'?'나를 소개하고 관심 분야와 사용할 수 있는 도구를 알려주세요.':section==='contacts'?'다른 사람에게 보여줄 연락처와 공개 범위를 관리합니다.':'작품 공개와 팀원 모집을 위한 Creator 권한을 신청합니다.'}</p></header><AccountNav/><CreatorProfilePanel section={section}/></Base>
