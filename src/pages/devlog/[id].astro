---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { projects } from '../../lib/content';
import { url } from '../../lib/urls';
export async function getStaticPaths() { return (await getCollection('devlog', ({ data }) => !data.draft)).map((post) => ({ params: { id: post.id }, props: { post } })); }
interface Props { post: CollectionEntry<'devlog'>; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const project = projects.find((p) => p.id === post.data.projectId);
---
<Base title={post.data.title} description={post.data.description} type="article" schema={{ '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), author: { '@type': 'Person', name: 'MINSEC' }, mainEntityOfPage: new URL(url(`devlog/${post.id}/`), Astro.site).href }}>
  <header class="page-header"><a class="text-link" href={url('devlog/')}>← Devlog</a><h1 style="font-size:clamp(32px,4.5vw,52px);line-height:1.4">{post.data.title}</h1><p>{post.data.description}</p><div class="article-meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time><span>{post.data.category}</span>{post.data.sample && <span>예시 글</span>}</div></header>
  {post.data.sample && <p class="notice">이 글은 MVP에 포함된 예시 초안입니다. 실제 성과나 검증 결과를 보고하는 글이 아닙니다.</p>}
  <p><a class="text-link" href={url(`admin/content/?collection=devlog&post=${post.id}`)}>이 글 편집 →</a></p>
  <div class="article-layout"><aside class="article-side" aria-label="글 목차">{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}{project && <a href={url(`projects/${project.id}/`)}>프로젝트 보기 ↗</a>}</aside><article class="prose"><Content /></article></div>
</Base>
