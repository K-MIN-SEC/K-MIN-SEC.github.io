---
import CreatorHeroVisual from '../components/CreatorHeroVisual.astro';
import Base from '../layouts/Base.astro';import ContentCard from '../components/ContentCard.astro';import {publicDB,type Kind} from '../lib/server';
let entries:Record<string,any>[]=[],teamups:Record<string,any>[]=[],error=false;
try{const db=publicDB();const [latest,recruiting]=await Promise.all([db.from('creator_entries').select('*').eq('kind','work').eq('visibility','public').eq('moderation_status','visible').is('deleted_at',null).order('featured',{ascending:false}).order('created_at',{ascending:false}).limit(6),db.from('creator_entries').select('*').eq('kind','teamup').eq('visibility','public').eq('moderation_status','visible').is('deleted_at',null).order('featured',{ascending:false}).order('created_at',{ascending:false}).limit(3)]);if(latest.error)throw latest.error;if(recruiting.error)throw recruiting.error;entries=latest.data;teamups=recruiting.data;}catch{error=true;}
if(error)Astro.response.status=503;
---
<Base title="작업이 다음 기회가 되는 곳" noindex={error}><section class="cs-hero cs-hero-with-visual"><div class="creator-hero-copy"><span class="eyebrow">MAKE. SHARE. GROW TOGETHER.</span><h1>당신의 작업에서,<br/><em>우리의 다음 프로젝트로.</em></h1><p>작은 실험부터 함께 완성한 게임까지. 작업을 기록하고, 동료를 만나고, 직접 참여한 경험을 포트폴리오로 쌓아보세요.</p><div class="cs-actions"><a class="button primary" href="/studio/">내 작업 기록하기 ↗</a><a class="button secondary" href="/team-up/">함께 만들 사람 찾기</a></div></div><CreatorHeroVisual/></section><div class="cs-bar"><div><span class="eyebrow">FROM THE COMMUNITY</span><h2>새로운 작업</h2></div><a href="/works/">모든 작업 →</a></div>{error?<p class="cs-empty" role="alert">현재 작업 목록을 연결하지 못했습니다. 잠시 후 다시 확인해 주세요.</p>:entries.length?<div class="cs-grid">{entries.map(item=><ContentCard item={item} kind={item.kind as Kind}/>)}</div>:<div class="cs-empty"><h2>첫 작업의 주인공이 되어주세요.</h2><p>아직 공개된 작업이 없습니다. 프로필을 만들고 Creator 승인을 받은 뒤 첫 작품을 남길 수 있어요.</p><a class="button primary" href="/account/profile/">프로필 만들기</a></div>}
<section class="home-teamup"><div class="cs-bar"><div><span class="eyebrow">FIND YOUR NEXT TEAM</span><h2>지금 함께할 사람을 찾고 있어요.</h2><p>모집 중인 프로젝트와 필요한 역할을 확인해 보세요.</p></div><a class="button secondary" href="/team-up/">Team Up 전체 보기 →</a></div>{teamups.length?<div class="cs-grid">{teamups.map(item=><ContentCard item={item} kind="teamup"/>)}</div>:<div class="teamup-empty"><div><strong>첫 팀원을 찾고 있나요?</strong><p>프로젝트 목표와 필요한 역할을 알려주세요.</p></div><a class="button primary" href="/studio/?kind=teamup">팀원 모집 작성</a></div>}</section>
<section class="cs-grid"><a class="cs-card" href="/projects/"><span class="eyebrow">PROJECT EXPERIENCE</span><h2>함께한 경험을 기록</h2><p>프로젝트 초대를 수락한 참여 이력이 내 프로필에도 쌓입니다.</p></a><a class="cs-card" href="/members/"><span class="eyebrow">PORTFOLIO ARCHIVE</span><h2>조건으로 동료 찾기</h2><p>직군, 도구, 관심 분야와 참여 상태로 필요한 창작자를 찾아보세요.</p></a><a class="cs-card" href="/space/"><span class="eyebrow">OPEN SPACE</span><h2>생각은 자유롭게</h2><p>회원이면 누구나 글·댓글·자료를 나눌 수 있습니다.</p></a></section></Base>
