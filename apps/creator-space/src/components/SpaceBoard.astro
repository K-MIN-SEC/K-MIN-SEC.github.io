---
import AuthGate from './AuthGate.astro';
const extended = import.meta.env.PUBLIC_SPACE_EXTENDED === 'true';
const {postId}=Astro.props;
---
<section class="space-board" data-space-board data-shared-post={postId} aria-labelledby="space-board-title">
  <div class="section-heading"><h2 id="space-board-title">Space 게시판</h2><a class="button primary" href="#write">+ 글쓰기</a></div>
  <div class="space-compose">
    <div><span class="eyebrow">OPEN BOARD</span><h2 id="write" tabindex="-1">작업과 생각 공유하기</h2><p>게임, 개발, 아트, 생성형 AI에 관한 작업이나 의견을 나눠주세요.</p></div>
    <AuthGate><form data-post-form>
      <div class="form-row"><label>닉네임<input name="display_name" maxlength="24" autocomplete="nickname" required /></label><label>제목<input name="title" minlength="2" maxlength="80" required /></label></div>
      <label>내용<textarea name="body" minlength="2" maxlength="2000" rows="5" required></textarea></label>
      <label>작업 링크 <small>(선택)</small><input name="link_url" type="url" maxlength="500" placeholder="https://" /></label>
      {extended && <><label>게시글 비밀번호 <small>(선택 · 비워두면 공개글)</small><input name="password" type="password" minlength="8" maxlength="72" autocomplete="off" /><small>계정 비밀번호와 별개입니다. 8자 이상으로 정해 공유할 사람에게 전달해 주세요.</small></label><label>첨부파일 <small>(이미지·PDF·TXT·한글·Word·Excel, 각 10MB 이하 · 최대 5개)</small><input name="files" type="file" multiple accept=".jpg,.jpeg,.png,.webp,.gif,.pdf,.txt,.hwp,.hwpx,.docx,.xlsx,.ods" /></label></>}
      <div class="form-actions"><small>{extended ? '공지 등록은 관리자가 게시 후 설정할 수 있습니다.' : '가입한 회원은 누구나 작성할 수 있습니다.'}</small><button class="button primary" type="submit">게시하기</button></div>
    </form></AuthGate>
  </div>
  <p class="community-status" data-space-status role="status">Space를 불러오는 중입니다.</p>
  <div class="space-feed" data-space-feed aria-live="polite"></div>
  <button class="button secondary" data-space-more type="button" hidden>더 보기</button>
  <dialog class="report-dialog" data-space-report-dialog>
    <form method="dialog" data-space-report-form>
      <h3>게시물 신고</h3><p>관리자가 내용을 확인할 수 있도록 이유를 알려주세요.</p>
      <label>신고 이유<select name="reason" required><option value="spam">스팸 또는 광고</option><option value="harassment">괴롭힘 또는 혐오 표현</option><option value="unsafe">개인정보 또는 위험한 내용</option><option value="other">기타 부적절한 내용</option></select></label>
      <input type="hidden" name="target_id" /><input type="hidden" name="target_type" />
      <div class="form-actions"><button class="button secondary" value="cancel">취소</button><button class="button primary" value="submit">신고하기</button></div>
    </form>
  </dialog>
</section>

<script>import '../lib/space-board';</script>
