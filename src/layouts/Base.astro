---
import '../styles/global.css';
import { url } from '../lib/urls';
import { siteInfo } from '../lib/site-info';
interface Props { title: string; description: string; type?: 'website' | 'article'; schema?: Record<string, unknown>; noindex?: boolean; }
const { title, description, type = 'website', schema, noindex = false } = Astro.props;
const fullTitle = `${title} — MINSEC`;
const canonical = new URL(Astro.url.pathname.replace(/\/404\/$/, '/404.html'), Astro.site);
const isPlaceholder = Astro.site?.hostname === 'example.com';
const nav = [{ label: 'Home', path: '' }, { label: 'Projects', path: 'projects/' }, { label: 'Play', path: 'play/' }, { label: 'Devlog', path: 'devlog/' }, { label: 'Space', path: 'space/' }, { label: 'About', path: 'about/' }];
const graph = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebSite', '@id': new URL(url(''), Astro.site).href + '#website', name: 'MINSEC', url: new URL(url(''), Astro.site).href, inLanguage: 'ko-KR', description: '게임을 만들고 생성형 AI를 탐구하는 MINSEC의 개인 포트폴리오.' },
  { '@type': 'WebPage', name: fullTitle, description, url: canonical.href, inLanguage: 'ko-KR' },
  ...(schema ? [schema] : []),
] };
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101410" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex || isPlaceholder ? 'noindex, follow' : 'index, follow'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MINSEC" />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header wrap">
      <a class="brand" href={url('')} aria-label="MINSEC 홈"><img src={url('favicon.svg')} alt="" width="30" height="30" />MINSEC<span class="brand-period">.</span></a>
      <nav aria-label="주요 메뉴">
        {nav.map(({ label, path }) => <a href={url(path)} aria-current={(path === '' ? Astro.url.pathname === url('') : Astro.url.pathname.startsWith(url(path))) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-account"><a href={url('account/')} data-account-link>로그인 / 가입</a><a href={url('admin/')}>관리자</a></div>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer wrap">
      <div class="footer-brand"><a class="brand" href={url('')}>MINSEC<span class="brand-period">.</span></a><p>생각을 만들고, 만드는 과정을 기록합니다.</p></div>
      <address class="footer-contact"><a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a>{siteInfo.phone && <a href={`tel:${siteInfo.phoneHref || siteInfo.phone}`}>{siteInfo.phone}</a>}<a href={url('admin/')}>관리</a></address>
      <span>© {new Date().getFullYear()} MINSEC</span>
    </footer>
    <script>import '../lib/events';</script>
    <script>
      import { supabase } from '../lib/supabase';
      const update = (signedIn: boolean) => { document.querySelectorAll('[data-account-link]').forEach((link) => { link.textContent = signedIn ? '내 계정' : '로그인 / 가입'; }); };
      supabase?.auth.getSession().then(({ data }) => update(Boolean(data.session && !data.session.user.is_anonymous)));
      supabase?.auth.onAuthStateChange((_event, session) => update(Boolean(session && !session.user.is_anonymous)));
    </script>
  </body>
</html>
