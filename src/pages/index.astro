---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LogList from '../components/LogList.astro';
import { projects, playItems } from '../lib/content';
import { url } from '../lib/urls';
import { getCollection } from 'astro:content';
const posts = (await getCollection('devlog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const featured = projects.filter((p) => p.featured);
---
<Base title="게임을 만들고, 가능성을 실험합니다" description="MINSEC의 게임 개발과 생성형 AI 탐구. 프로젝트 포트폴리오, 개발 기록, 브라우저에서 만날 Playable Lab을 둘러보세요.">
  <section class="hero">
    <div class="hero-intro"><span class="eyebrow">INDEPENDENT CREATOR / MINSEC</span><h1>생각을 플레이로.<br />실험을 <em>가능성으로.</em></h1><p>게임을 만들고, 생성형 AI를 탐구합니다.<br />완성된 결과와 아직 만드는 중인 이야기까지,<br class="mobile-break" /> 이곳에 차곡차곡 기록합니다.</p><div class="hero-actions"><a class="button primary" href={url('projects/')}>프로젝트 둘러보기 <span aria-hidden="true">↗</span></a><a class="button secondary" href={url('play/')}>Playable Lab <span aria-hidden="true">→</span></a></div></div>
    <aside class="hero-note"><span class="eyebrow">THE WORK, IN PROGRESS</span><div class="big-mark" aria-hidden="true">m<span>:</span>s</div><p>분과 초 사이,<br />작은 아이디어가 자라는 시간.</p><div class="note-rule"></div><span class="eyebrow">GAME DESIGN & GENERATIVE AI</span></aside>
  </section>
  <section class="home-projects"><div class="section-heading"><div><span class="eyebrow">01 / SELECTED WORK</span><h2>지금 만들고 있는 것들<span class="count">{String(projects.length).padStart(2, '0')}</span></h2></div><a class="text-link" href={url('projects/')}>모든 프로젝트 <span aria-hidden="true">↗</span></a></div><div class="project-grid">{featured.map((project, index) => <ProjectCard project={project} index={index} />)}</div>{featured.length === 0 && <p class="empty">새로운 프로젝트를 준비하고 있습니다.</p>}</section>
  <section class="lab-banner"><div><span class="eyebrow">02 / PLAYABLE LAB</span><h2>읽는 것에서, <em>플레이하는 것으로.</em></h2><p>아이디어를 직접 만나는 작은 실험실. {playItems.filter((p) => p.status === 'coming-soon').length}개의 데모를 준비하고 있습니다.</p></div><a class="button secondary" href={url('play/')}>실험실 둘러보기 <span aria-hidden="true">→</span></a></section>
  <section class="section-block"><div class="section-heading"><div><span class="eyebrow">03 / FIELD NOTES</span><h2>만드는 과정도, 하나의 작업.</h2></div><a class="text-link" href={url('devlog/')}>모든 기록 <span aria-hidden="true">↗</span></a></div><LogList posts={posts} /></section>
</Base>
