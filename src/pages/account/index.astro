---
import Base from '../../layouts/Base.astro';
import CreatorProfilePanel from '../../components/CreatorProfilePanel.astro';
import { url } from '../../lib/urls';
const emailLoginEnabled = import.meta.env.PUBLIC_EMAIL_LOGIN === 'true';
const githubLoginEnabled = import.meta.env.PUBLIC_GITHUB_LOGIN !== 'false';
const googleLoginEnabled = import.meta.env.PUBLIC_GOOGLE_LOGIN === 'true';
const creatorFoundationEnabled = import.meta.env.PUBLIC_CREATOR_FOUNDATION === 'true';
const enabledProviders = [
  googleLoginEnabled && { id: 'google', label: 'Google로 계속하기', className: 'primary' },
  githubLoginEnabled && { id: 'github', label: 'GitHub로 계속하기', className: googleLoginEnabled ? 'secondary' : 'primary' },
].filter(Boolean) as { id: 'google' | 'github'; label: string; className: string }[];
---
<Base title="Account · 로그인" description="MINSEC 로그인과 내 계정 관리" noindex>
  <header class="page-header"><span class="eyebrow">WELCOME TO MINSEC</span><h1>로그인<span class="brand-period">.</span></h1><p>연결된 소셜 계정으로 로그인하고 작업과 생각을 나눠보세요.</p></header>
  <section class="account-panel" aria-labelledby="account-title">
    <h2 id="account-title">계정으로 시작하기</h2>
    <p class="notice" data-account-status role="status">계정 서비스를 확인하고 있습니다.</p>
    <div class="oauth-actions" data-oauth-actions>
      {enabledProviders.map((provider) => <button class={`button ${provider.className}`} type="button" data-oauth={provider.id}>{provider.label}</button>)}
    </div>
    {!googleLoginEnabled && <p class="provider-note">Google 로그인은 연결을 준비하고 있습니다.</p>}
    {emailLoginEnabled && <details class="email-login"><summary>운영자용 이메일 링크 로그인</summary><form data-account-form><fieldset class="community-fields" disabled><label>이메일<input name="email" type="email" autocomplete="email" required placeholder="you@example.com" /></label><button class="button secondary" type="submit">로그인 링크 받기</button><p>기존 운영자 계정 확인용입니다. 일반 회원 가입은 Google/GitHub를 사용합니다.</p></fieldset></form></details>}
    <div data-account-session hidden><p data-account-email></p><div class="form-actions"><a class="button primary" href={url('space/#write')}>Space에 글쓰기</a><a class="button secondary" data-account-admin href={url('admin/')} hidden>관리자 화면</a><button class="button secondary" data-account-logout type="button">로그아웃</button></div></div>
  </section>
  {creatorFoundationEnabled && <CreatorProfilePanel />}
</Base>
<script>
  import { supabase, messageOf } from '../../lib/supabase';
  const form = document.querySelector<HTMLFormElement>('[data-account-form]');
  const fields = form?.querySelector<HTMLFieldSetElement>('fieldset');
  const oauth = document.querySelector<HTMLElement>('[data-oauth-actions]')!;
  const status = document.querySelector<HTMLElement>('[data-account-status]')!;
  const sessionBox = document.querySelector<HTMLElement>('[data-account-session]')!;
  async function refresh() {
    if (!supabase) { status.textContent = '아직 계정 서비스가 연결되지 않았습니다. 연결이 끝나면 이 화면에서 이메일로 로그인할 수 있습니다.'; return; }
    const { data, error } = await supabase.auth.getSession();
    if (error) throw error;
    const user = data.session?.user;
    const signedIn = Boolean(user && !user.is_anonymous);
    if (form && fields) { form.hidden = signedIn; fields.disabled = signedIn; }
    oauth.hidden = signedIn; sessionBox.hidden = !signedIn;
    status.textContent = signedIn ? '로그인되었습니다.' : 'Google 또는 GitHub 계정으로 로그인할 수 있습니다.';
    if (signedIn && user) {
      document.querySelector<HTMLElement>('[data-account-email]')!.textContent = user.email ?? '로그인한 계정';
      const admin = await supabase.from('admins').select('user_id').eq('user_id', user.id).maybeSingle();
      document.querySelector<HTMLElement>('[data-account-admin]')!.hidden = !admin.data;
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-oauth]').forEach((button) => button.addEventListener('click', async () => {
    if (!supabase) return; button.disabled = true;
    try {
      const provider = button.dataset.oauth as 'google' | 'github';
      const { error } = await supabase.auth.signInWithOAuth({ provider, options: { redirectTo: new URL(import.meta.env.BASE_URL + 'account/', location.origin).href } });
      if (error) throw error;
    } catch (error) { status.textContent = messageOf(error); button.disabled = false; }
  }));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault(); if (!supabase) return;
    const email = String(new FormData(form).get('email')).trim(); if (fields) fields.disabled = true;
    try {
      const { error } = await supabase.auth.signInWithOtp({ email, options: { emailRedirectTo: new URL(import.meta.env.BASE_URL + 'account/', location.origin).href } });
      if (error) throw error;
      status.textContent = '로그인 링크를 보냈습니다. 이메일을 확인해 주세요.';
    } catch (error) { status.textContent = messageOf(error); }
    finally { if (fields) fields.disabled = false; }
  });
  document.querySelector('[data-account-logout]')!.addEventListener('click', async () => {
    const result = await supabase?.auth.signOut();
    if (result?.error) { status.textContent = messageOf(result.error); return; }
    location.reload();
  });
  // Auth callbacks stay synchronous; the database lookup runs after the auth lock is released.
  supabase?.auth.onAuthStateChange(() => { setTimeout(() => refresh().catch((error) => { status.textContent = messageOf(error); }), 0); });
  refresh().catch((error) => { status.textContent = messageOf(error); });
</script>
